import event, cyberpi, mbuild, mbot2, time
 
vel = 20
fase_programa = 0 
# Fase 0: Siguiendo linea negra hasta llegar a la azul
# Fase 1: Girar y seguir linea azul
# Fase 2: Apagar vela y llegar a la linea amarilla

# Declaracion estados de lineas de color
estado_negro_all = mbuild.quad_rgb_sensor.get_black_sta("all", 1) 
estado_verde_all = mbuild.quad_rgb_sensor.get_green_sta("all", 1)
estado_rojo_all = mbuild.quad_rgb_sensor.get_red_sta("all", 1)
estado_azul_all = mbuild.quad_rgb_sensor.get_blue_sta("all", 1)
estado_cyan_all = mbuild.quad_rgb_sensor.get_cyan_sta("all", 1)
estado_amarillo_all = mbuild.quad_rgb_sensor.get_yellow_sta("all", 1)
estado_blanco_all = mbuild.quad_rgb_sensor.get_white_sta("all", 1)  
    
# Deteccion de color sensores interiores
estado_negro_interior = mbuild.quad_rgb_sensor.get_black_sta("middle", 1) 
estado_verde_interior = mbuild.quad_rgb_sensor.get_green_sta("middle", 1)
estado_rojo_interior = mbuild.quad_rgb_sensor.get_red_sta("middle", 1)
estado_azul_interior = mbuild.quad_rgb_sensor.get_blue_sta("middle", 1)
estado_cyan_interior = mbuild.quad_rgb_sensor.get_cyan_sta("middle", 1)
estado_amarillo_interior = mbuild.quad_rgb_sensor.get_yellow_sta("middle", 1)
estado_blanco_interior = mbuild.quad_rgb_sensor.get_white_sta("middle", 1)    


cyberpi.console.clear()
cyberpi.console.println("Inicializando")

def actualizar_qrgb():
    
    global fase_programa
    
    # Declaracion global 4 sensores
    global estado_negro_all, estado_verde_all, estado_rojo_all, estado_azul_all, estado_amarillo_all, estado_blanco_all, estado_cyan_all
    # Declaracion global sensores interiores (r1, l2)
    global estado_negro_interior, estado_verde_interior, estado_rojo_interior, estado_azul_interior, estado_amarillo_interior, estado_blanco_interior, estado_cyan_interior
    
    if fase_programa <= 1: # Actualizar estados utilizados en la fase 0 y 1
        estado_negro_all = mbuild.quad_rgb_sensor.get_black_sta("all", 1)
        estado_negro_interior = mbuild.quad_rgb_sensor.get_black_sta("middle", 1)
        
        estado_azul_all = mbuild.quad_rgb_sensor.get_blue_sta("all", 1)
        estado_azul_interior = mbuild.quad_rgb_sensor.get_blue_sta("middle", 1)
        estado_cyan_all = mbuild.quad_rgb_sensor.get_cyan_sta("all", 1)
        estado_cyan_interior = mbuild.quad_rgb_sensor.get_cyan_sta("middle", 1) 
        
    if fase_programa == 2:
        estado_azul_all = mbuild.quad_rgb_sensor.get_blue_sta("all", 1)
        estado_azul_interior = mbuild.quad_rgb_sensor.get_blue_sta("middle", 1)
        estado_cyan_all = mbuild.quad_rgb_sensor.get_cyan_sta("all", 1)
        estado_cyan_interior = mbuild.quad_rgb_sensor.get_cyan_sta("middle", 1) 


def linea_negra():
    
    if (estado_negro_interior == 3): # Ambos sensores detectados
        mbot2.drive_speed(vel - 10, -vel + 10) # Mover hacia adelante 
        if estado_azul_all == 1:
            mbot2.drive_speed(0,0)
                     
    elif (estado_negro_interior == 1): # Sensor derecho detectado, izquierdo no detectado
        mbot2.drive_speed(vel - 5, 0) # Girar un poco a la derecha
                
    elif (estado_negro_interior == 2): # Sensor izquierdo detectado, derecho no detectado
        mbot2.drive_speed(0, -vel + 5) # Girar un poco a la izquierda


def linea_azul(): # Girar y seguir la linea azul hasta no detectar mas azul
    global fase_programa
    cyberpi.console.clear()
    cyberpi.console.println("Linea azul")
             
    if estado_azul_interior != 3 or estado_cyan_interior != 3: # 3 = ambos sensores interiores detectados
        mbot2.drive_speed(vel - 15, 0) # velocidad (5,0) - Girar a la derecha
            
    else:
        if estado_azul_interior == 3 or estado_cyan_interior == 3:
            mbot2.drive_speed(vel, -vel)
        elif estado_azul_interior == 1 or estado_cyan_interior == 1: # Sensor derecho detectado, izquierdo no detectado
            mbot2.drive_speed(vel - 5, 0) # Girar un poco a la derecha  
        elif estado_azul_interior == 2 or estado_cyan_interior == 2: # Sensor izquierdo detectado, derecho no detectado
            mbot2.drive_speed(0, -vel + 5) # Girar un poco a la izquierda
        elif estado_azul_interior == 0 and estado_cyan_interior == 0:
            fase_programa = 2
        
        
            
def seguir_linea():
    global fase_programa
    cyberpi.console.clear() 
    
    while True:
        actualizar_qrgb()
    
        if fase_programa == 0: # Fase 0: Seguir linea negra hasta llegar a la azul
        
            if (estado_azul_all == 3 or estado_azul_all == 1) or (estado_cyan_all == 3 or estado_cyan_all == 1): # Si sensor R1 o R2 y R1 detectado, siguiente fase
                fase_programa = 1
                mbot2.drive_speed(0,0) # Parar y pasar a la proxima fase
            else:
                linea_negra()
                
                        
        elif fase_programa == 1: # Girar y seguir linea azul hasta no detectar mas azul
             linea_azul()
        
        elif fase_programa == 2:
            mbot2.drive_speed(0, 0)
    


@event.start
def on_start():
    seguir_linea()
    
